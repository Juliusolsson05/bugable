generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS - Aligned with QA Engine
// ============================================

enum JobStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum CompletionReason {
  done        // AI decided testing is complete
  max_turns   // Hit maximum turns limit
  error       // Job crashed/errored
}

enum FindingSeverity {
  critical
  high
  medium
  low
}

enum FindingCategory {
  error              // Console errors, crashes, 404s
  layout_broken      // Overlapping content, broken layouts
  image_broken       // Broken image links
  form_validation    // Form/input issues
  accessibility      // Accessibility violations
  visual_overflow    // Content extending beyond containers
  responsive_break   // Mobile/tablet layout issues
  typography         // Text truncation, readability
  interactive_fail   // Buttons, links not working
  contrast           // Low contrast issues
}

// ============================================
// MODELS
// ============================================

/// User profile - extends Supabase auth.users
model Profile {
  id        String   @id @db.Uuid
  email     String?
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  sites Site[]

  @@map("profiles")
}

/// Website being tested
model Site {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  baseUrl   String   @map("base_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user  Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages Page[]

  @@index([userId])
  @@map("sites")
}

/// Individual page within a site
model Page {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  path      String
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  site Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  jobs Job[]

  @@unique([siteId, path])
  @@index([siteId])
  @@map("pages")
}

/// Test job run on a page
model Job {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId           String            @map("page_id") @db.Uuid
  status           JobStatus         @default(pending)
  progress         Int               @default(0)
  currentStep      String?           @map("current_step")
  totalTurns       Int?              @map("total_turns")
  completionReason CompletionReason? @map("completion_reason")
  errorMessage     String?           @map("error_message")
  startedAt        DateTime?         @map("started_at")
  completedAt      DateTime?         @map("completed_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at")

  page     Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  turns    Turn[]
  findings Finding[]

  @@index([pageId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("jobs")
}

/// A single turn in the QA testing process
model Turn {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId         String   @map("job_id") @db.Uuid
  number        Int      // 1, 2, 3...
  action        String?  // What action was taken (null for turn 1)
  reasoning     String   // AI's reasoning for this turn
  screenshotUrl String?  @map("screenshot_url")
  createdAt     DateTime @default(now()) @map("created_at")

  job      Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  findings Finding[]

  @@unique([jobId, number])
  @@index([jobId])
  @@map("turns")
}

/// Bug/issue discovered during testing
model Finding {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId       String          @map("job_id") @db.Uuid
  turnId      String?         @map("turn_id") @db.Uuid
  severity    FindingSeverity
  category    FindingCategory
  title       String
  description String
  location    String          // Human-readable: "Hero section CTA button"
  createdAt   DateTime        @default(now()) @map("created_at")

  job  Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  turn Turn? @relation(fields: [turnId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([turnId])
  @@index([severity])
  @@map("findings")
}

// ============================================
// MARKETING / LANDING PAGE (isolated)
// ============================================

/// Beta waitlist signups from landing page
model WaitlistEntry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  source    String   @default("landing")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("waitlist")
}

/// Contact form submissions from landing page
model ContactMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String?
  email     String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("contact_messages")
}
